<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/gray_light"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top Row: Truck, Vehicle info, and Price side-by-side -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Truck Icon Container on Left -->
            <ImageView
                android:id="@+id/ivVehicleIcon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_truck" />

            <!-- Title & Subtitle Info -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:layout_toStartOf="@+id/layoutPriceMenu"
                android:layout_toEndOf="@+id/ivVehicleIcon"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvVehicleType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Four Wheeler"
                    android:textColor="@color/black"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvDateTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="05 Feb, 4:46 PM"
                        android:textColor="@color/gray_text"
                        android:textSize="11.5sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        android:text="|"
                        android:textColor="@color/gray_light"
                        android:textSize="11.5sp" />

                    <TextView
                        android:id="@+id/tvOrderId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Order ID: #ORD12345"
                        android:textColor="@color/gray_text"
                        android:textSize="11.5sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Price & Ellipsis Layout aligned to Far Right -->
            <LinearLayout
                android:id="@+id/layoutPriceMenu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="end|center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹ 229.0"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Vertical three dots menu icon -->
                <ImageView
                    android:id="@+id/ivMenu"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/ic_more_vert"
                    app:tint="@color/gray_text" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Dynamic Location block with visual Vertical Connected Line -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <!-- Timeline connector icons and line -->
            <LinearLayout
                android:layout_width="16dp"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="4dp">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_location_pickup"
                    app:tint="@color/green_pickup" />

                <!-- Vertical solid connection line -->
                <View
                    android:layout_width="1.5dp"
                    android:layout_height="32dp"
                    android:background="@color/gray_light" />

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_location_drop"
                    app:tint="@color/red_drop" />
            </LinearLayout>

            <!-- Destination Address Labels -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <!-- Pickup location text -->
                <TextView
                    android:id="@+id/tvPickupLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="741, Gumanwara"
                    android:textColor="@color/black"
                    android:textSize="13sp" />

                <!-- Spacing block matching the view line -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="16dp" />

                <!-- Drop location text -->
                <TextView
                    android:id="@+id/tvDropLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="00, Main Rd, Shivaji Nagar, Jhansi, Uttar Pradesh 284001, India"
                    android:textColor="@color/black"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Status Bar Badge and action Buttons layout row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Cancelled / Completed Status Badge -->
            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_cancelled"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp"
                android:text="CANCELLED"
                android:textColor="@color/red_badge_text"
                android:textSize="10sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Invoice Action Button with Download bracket icon -->
            <Button
                android:id="@+id/btnInvoice"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_button_white"
                android:drawableStart="@drawable/ic_download"
                android:drawablePadding="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="90dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Invoice"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textSize="12sp"
                app:iconTint="@color/black" />

            <!-- Book Again Primary CTA Button -->
            <Button
                android:id="@+id/btnBookAgain"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_button_yellow"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="100dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Book Again"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>